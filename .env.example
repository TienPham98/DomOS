# ==============================================================================
# DomOS — Environment Variables & Secrets Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual private tokens, keys, and URLs.
# WARNING: NEVER commit your active .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ESP32-S3 Hardware & Network Configuration
# ------------------------------------------------------------------------------
DOMOS_HOST_IP=<HOST_IP>
ESP32_DEVICE_IP=<DEVICE_IP>
ESP32_GATEWAY_IP=<GATEWAY_IP>
ESP32_NETMASK=<NETWORK_MASK>
ESP32_PORT=80
ESP32_MAC_ADDRESS=<DEVICE_MAC>

# ------------------------------------------------------------------------------
# 2. OpenRouter Cloud Voice Gateway (backend-python)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DOMOS_DEBUG=False

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
STT_PROVIDER=google-web
STT_LANGUAGE=vi-VN
TTS_PROVIDER=google
TTS_VOICE=vi-VN-HoaiMyNeural
CONVERSATION_DB_PATH=data/conversations.db

# ------------------------------------------------------------------------------
# 3. Core Backend Configuration (backend-go)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8081

# PostgreSQL DSN (Falls back to SQLite if offline)
DATABASE_URL=host=localhost user=domos password=domos dbname=domos port=5432 sslmode=disable TimeZone=UTC

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRY_HOURS=72

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=domos-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Web Dashboard Configuration (dashboard-next)
# ------------------------------------------------------------------------------
PUBLIC_BASE_URL=http://<HOST_IP>:8081
OPENROUTER_HTTP_REFERER=http://<HOST_IP>:3000
DOMOS_MQTT_URI=mqtt://<HOST_IP>:1883
DOMOS_AI_WS_URI=ws://<HOST_IP>:8000/api/v1/voice/stream
NEXT_PUBLIC_API_URL=http://<HOST_IP>:8081
NEXT_PUBLIC_AI_GATEWAY_URL=http://<HOST_IP>:8000
NEXT_PUBLIC_DEVICE_IP=<DEVICE_IP>
NEXT_PUBLIC_HOST_IP=<HOST_IP>
NEXT_PUBLIC_MQTT_URL=mqtt://<HOST_IP>:1883

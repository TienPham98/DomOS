# ==============================================================================
# DomOS — Environment Variables & Secrets Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual private tokens, keys, and URLs.
# WARNING: NEVER commit your active .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ESP32-S3 Hardware & Network Configuration
# ------------------------------------------------------------------------------
ESP32_DEVICE_IP=192.168.0.106
ESP32_PORT=80
ESP32_MAC_ADDRESS=B8:1F:3F:C3:97:54

# ------------------------------------------------------------------------------
# 2. AI Gateway & LLM Service Keys (backend-python)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=gpt-4o

# Audio Engine Settings
STT_ENGINE=whisper
TTS_ENGINE=edge-tts
TTS_VOICE=vi-VN-HoaiMyNeural

# ------------------------------------------------------------------------------
# 3. Core Backend Configuration (backend-go)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080

# PostgreSQL DSN (Falls back to SQLite if offline)
DATABASE_URL=host=localhost user=domos password=domos dbname=domos port=5432 sslmode=disable TimeZone=UTC

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRY_HOURS=72

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=domos-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Web Dashboard Configuration (dashboard-next)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://192.168.0.105:8080
NEXT_PUBLIC_AI_GATEWAY_URL=http://192.168.0.105:8000
NEXT_PUBLIC_DEVICE_IP=192.168.0.106
